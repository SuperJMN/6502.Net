<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    
    <!-- Package metadata -->
    <PackageId>Zafiro.Compilers.Sixty502DotNet.Shared</PackageId>
    <Description>6502.Net shared library for cross-assembly functionality (Zafiro fork)</Description>
    <Authors>informedcitizenry</Authors>
    <Copyright>Copyright (c) 2017-2024 informedcitizenry</Copyright>
    <PackageProjectUrl>https://github.com/informedcitizenry/6502.Net</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Antlr4BuildTasks" Version="12.10.0">
        <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <PackageReference Include="CSharpFunctionalExtensions" Version="3.6.0" />
  </ItemGroup>
  
  <ItemGroup>
    <Antlr4 Include="Parser\ANTLR\Grammar\SyntaxLexer.g4">
        <Package>Sixty502DotNet.Shared</Package>
        <CopyToOutputDirectory></CopyToOutputDirectory>
    </Antlr4>
    <Antlr4 Include="Parser\ANTLR\Grammar\SyntaxParser.g4">
        <Package>Sixty502DotNet.Shared</Package>
        <Listener>true</Listener>
        <Visitor>true</Visitor>
        <CopyToOutputDirectory></CopyToOutputDirectory>
    </Antlr4>
    <Antlr4 Include="Parser\ANTLR\Grammar\Json.g4">
        <Package>Sixty502DotNet.Shared</Package>
        <Listener>true</Listener>
        <Visitor>true</Visitor>
        <CopyToOutputDirectory></CopyToOutputDirectory>
    </Antlr4>
  </ItemGroup>
  
  <ItemGroup>
    <None Update="JSON\ConfigSchema.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
